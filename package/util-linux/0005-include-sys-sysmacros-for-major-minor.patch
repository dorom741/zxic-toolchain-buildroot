include sys/sysmacros.h for major/minor/makedev

Recent glibc no longer defines the major(), minor() and makedev() macros
through <sys/types.h>; they live in <sys/sysmacros.h>.  lib/loopdev.c
already includes it, so add the same include to the remaining users built
by this configuration.

Signed-off-by: jeep <jeep@local>

--- util-linux-2.26.2.orig/lib/ismounted.c	2015-04-29 15:52:21.960364341 +0800
+++ util-linux-2.26.2/lib/ismounted.c	2026-10-01 19:48:47.631900864 +0800
@@ -18,6 +18,7 @@
 #include <sys/stat.h>
 #include <ctype.h>
 #include <sys/param.h>
+#include <sys/sysmacros.h>
 #ifdef __APPLE__
 #include <sys/ucred.h>
 #include <sys/mount.h>
--- util-linux-2.26.2.orig/lib/sysfs.c	2015-04-29 18:36:45.149169921 +0800
+++ util-linux-2.26.2/lib/sysfs.c	2026-10-01 19:48:47.631978638 +0800
@@ -5,6 +5,7 @@
  * Written by Karel Zak <kzak@redhat.com>
  */
 #include <ctype.h>
+#include <sys/sysmacros.h>
 
 #include "c.h"
 #include "at.h"
