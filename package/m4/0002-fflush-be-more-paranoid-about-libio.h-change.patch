fflush: be more paranoid about libio.h changes

Some glibc versions expose _IO_ftrylockfile but not _IO_EOF_SEEN through the
public headers.  Keep both checks so the compatibility code remains usable
across the supported host glibc versions.

Backported from Buildroot commit:
https://git.buildroot.net/buildroot/commit/?id=e915aaa5f5620a1f997763337b5387b3d6f4ee3e

Signed-off-by: jeep <jeep@local>

--- m4-1.4.17/lib/fflush.c	2026-10-01 18:34:47.221547387 +0800
+++ m4-1.4.17/lib/fflush.c	2026-10-01 18:34:47.292895852 +0800
@@ -33,7 +33,7 @@
 #undef fflush
 
 
-#if defined _IO_EOF_SEEN || __GNU_LIBRARY__ == 1 /* GNU libc, BeOS, Haiku, Linux libc5 */
+#if defined _IO_EOF_SEEN || defined _IO_ftrylockfile || __GNU_LIBRARY__ == 1 /* GNU libc, BeOS, Haiku, Linux libc5 */
 
